    "nodemailer": "^6.10.0",
    "pg": "^8.13.3",
    "socket.io": "^4.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20"
